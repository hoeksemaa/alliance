# Copy to .env.local for local development. Never commit .env files.

# Postgres connection string (Neon: use the pooled connection string).
# Leave it empty to use the embedded database (PGlite) in .data/pglite.
DATABASE_URL=

# Optional: another folder for the embedded database.
# PGLITE_DIR=.data/pglite

# Optional: the code the first account (the admin) must give. Set it on a public site.
# SETUP_CODE=
